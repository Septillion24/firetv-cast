<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.firetvcast.helper"
    android:versionCode="3"
    android:versionName="1.2">

    <!-- Target 22 so the permissions below are granted at install, with no prompts on the TV. -->
    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="22" />

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- HomeKeeper talks to ShellHelper over a loopback TCP port. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="Send to TV helper" android:allowBackup="false">
        <receiver android:name=".Command" android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Our home screen. Listed with the TV's apps too, so it can be opened from Amazon's home. -->
        <activity android:name=".Home" android:label="Home"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask" android:stateNotNeeded="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".Hdmi" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service android:name=".HomeKeeper" android:label="Home screen keeper" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_keeper" />
        </service>
    </application>
</manifest>
